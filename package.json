{
  "name": "reeprov",
  "version": "0.1.0-beta.1",
  "description": "Local-first debugging and reproducibility infrastructure for AI agents.",
  "author": "Reeprov Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaulMermans/Reeprov.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "reeprov": "./bin/reeprov.mjs",
    "pulse": "./bin/pulse.mjs"
  },
  "scripts": {
    "dev": "tsx scripts/start-reeprov.ts --dev",
    "start": "tsx scripts/start-reeprov.ts",
    "dev:raw": "next dev",
    "start:raw": "next start",
    "studio": "tsx scripts/start-reeprov.ts",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "seed:traces": "node --experimental-strip-types scripts/seed-trace-run.ts",
    "seed:cs": "node --experimental-strip-types scripts/seed-campaign-sandbox-run.ts",
    "simulate:live": "node --experimental-strip-types scripts/simulate-live-run.ts",
    "reeprov": "node bin/reeprov.mjs",
    "pulse": "node bin/reeprov.mjs",
    "audit:paths": "node scripts/audit-private-paths.mjs",
    "audit:rename": "node scripts/audit-rename.mjs",
    "ci": "npm run audit:rename && npm run audit:paths && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "reeprov",
    "ai-agents",
    "debugging",
    "tracing",
    "reproducibility",
    "evals"
  ],
  "type": "module",
  "private": true,
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@xyflow/react": "^12.11.1",
    "jiti": "^2.7.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
