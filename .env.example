# Server-side only. Do not prefix secrets with NEXT_PUBLIC_.

# ── Required in production ─────────────────────────────────────────────────────

# Dashboard and scanner gate
AGENTPULSE_ACCESS_KEY=replace_with_long_random_private_key

# Separate key for external trace ingestion (must differ from ACCESS_KEY in production)
AGENTPULSE_INGEST_KEY=replace_with_different_long_random_key

# Postgres connection string — required in production, optional in local dev
# Vercel Postgres / Neon example:
#   DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Local Postgres (no SSL):
#   DATABASE_URL=postgresql://localhost:5432/agentpulse
DATABASE_URL=

# ── Optional ───────────────────────────────────────────────────────────────────

# File-backed store directory — LOCAL DEVELOPMENT ONLY.
# When DATABASE_URL is set, this variable is ignored.
# When DATABASE_URL is not set (local dev), defaults to .agentpulse in the project root.
# AGENTPULSE_STORE_DIR=.agentpulse

# For scanner — read-only GitHub token
GITHUB_TOKEN=github_pat_read_only_selected_repos

# LLM auditors (disabled by default — do not enable in CI)
ENABLE_LLM_AUDITORS=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
