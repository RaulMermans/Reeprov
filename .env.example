# Server-side only. Do not prefix secrets with NEXT_PUBLIC_.

# Required — dashboard and scanner gate
AGENTPULSE_ACCESS_KEY=replace_with_long_random_private_key

# Recommended — separate key for external trace ingestion (differs from ACCESS_KEY in production)
AGENTPULSE_INGEST_KEY=replace_with_different_long_random_key

# Optional — override run/report storage directory
# On Vercel, use /tmp/agentpulse (ephemeral, not durable across deploys)
# AGENTPULSE_STORE_DIR=.agentpulse

# For scanner — read-only GitHub token
GITHUB_TOKEN=github_pat_read_only_selected_repos

# LLM auditors (disabled by default — do not enable in CI)
ENABLE_LLM_AUDITORS=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
