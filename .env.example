# ═══════════════════════════════════════════════════════════════════════════════
# AgentPulse Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local to configure your instance.
# Never commit .env.local or production secrets to source control.

# ── Operating Mode ─────────────────────────────────────────────────────────────
# Required: Choose your deployment posture
#   personal_local  — (Default) Single developer, zero login screen, loopback bound
#   self_hosted     — Private server/VM/Docker, mandatory HttpOnly session auth
#   headless_ci     — Headless regression gates, pre-merge eval execution
AGENTPULSE_MODE=personal_local

# ── Common Settings (All Modes) ────────────────────────────────────────────────
# Optional: Custom data directory (defaults to ~/.agentpulse in user home directory)
# AGENTPULSE_HOME=~/.agentpulse

# ── PERSONAL_LOCAL Mode (Default) ──────────────────────────────────────────────
# No additional configuration required!
# Studio automatically binds to 127.0.0.1:3000.
# Local filesystem storage is used out-of-the-box.

# ── PRIVATE_SELF_HOSTED Mode ──────────────────────────────────────────────────
# Required when AGENTPULSE_MODE=self_hosted:
# Instance unlock password (must be long and random, min 32 chars)
AGENTPULSE_ACCESS_KEY=replace_with_long_random_private_key_min_32_chars

# Global fallback ingest key for external agents (MUST differ from ACCESS_KEY)
AGENTPULSE_INGEST_KEY=replace_with_different_long_random_key_min_32_chars

# Optional: PostgreSQL connection string (defaults to local filesystem store if unset)
# Example:
#   DATABASE_URL=postgresql://agentpulse:secret@localhost:5432/agentpulse?sslmode=disable
DATABASE_URL=

# ── HEADLESS_CI Mode ──────────────────────────────────────────────────────────
# Required for CI ingestion and headless regression checks
# AGENTPULSE_INGEST_KEY=ci_fallback_key_placeholder

# ── Developer Tools & Repository Scanning (Optional) ──────────────────────────
# Server-side read-only GitHub token for repository auditing features
# GITHUB_TOKEN=ghp_example_read_only_token_here

# LLM auditors (Disabled by default — do not enable in standard CI)
ENABLE_LLM_AUDITORS=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
